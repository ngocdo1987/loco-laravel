**/config/local.yaml
**/config/*.local.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*

# ts-rs auto-generates these from `src/dtos/**` on every `cargo test`/`cargo
# build` (see the `#[ts(export, ...)]` attributes) — regenerate, don't commit.
frontend/src/bindings/